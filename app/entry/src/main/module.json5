{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        // 智感握姿（2026-11-16，按华为官方文档 bpta-smart-reach）：
        // 官方示例声明的是 DETECT_GESTURE（不是我先写的 ACTIVITY_MOTION）；
        // holdingHandChanged 从 API 20 起、operatingHandChanged 从 API 15 起。
        // 两个都声明：老版本走 operating，新版本走 holding。取不到时客户端静默降级。
        "name": "ohos.permission.DETECT_GESTURE",
        "reason": "$string:permission_gravity_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.ACTIVITY_MOTION",
        "reason": "$string:permission_gravity_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "inuse"
        }
      },
      {
        // 网络类型（2.5.7 离线缓存的「仅 WiFi 下载」）：要判断当前是不是 WiFi，
        // 才决定排队的下载要不要出队。normal 级，安装即授予，不弹窗。
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        // 重力传感器：判断「用户是否改变了手机方向」——点全屏/按返回后的方向锁定，
        // 要等他真的把手机转过去才交还重力（2.4.6.22 反馈）。
        // normal 级，安装即授予，不弹窗。
        "name": "ohos.permission.ACCELEROMETER",
        "reason": "$string:permission_gravity_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "inuse"
        }
      },
      {
        // 后台播放（2.6.1.16）：切到后台 / 锁屏后继续出声，靠「音频播放」长时任务。
        // normal 级，安装即授予；仍需在下面 ability 里声明 backgroundModes。
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING"
      },
      {
        // 触感反馈（2.6.1.18）：收藏 / 删除确认 / 拖拽落位时给一记短震。
        // normal 级，安装即授予，不弹窗；没有马达的设备（模拟器）调用不报错、只是没感觉。
        "name": "ohos.permission.VIBRATE"
      }
    ],
    "metadata": [
      {
        "name": "ohos.net.network_config",
        "resource": "$profile:network_config"
      },
      {
        // 沉浸光感（API 26）：应用级开启，系统材质随深浅色与设备算力自适应。
        // 组件级仍可用 .systemMaterial() 单独覆盖（播放器控制层/面板就走组件级）。
        "name": "ohos.arkui.UIMaterial.state",
        "value": "enable"
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        // 后台播放（2.6.1.16）：声明了它 + KEEP_BACKGROUND_RUNNING 权限，
        // startBackgroundRunning(AUDIO_PLAYBACK) 才不会被系统拒。
        "backgroundModes": [
          "audioPlayback"
        ],
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ]
      }
    ],
    // 桌面服务卡片（2.6.1.26）：type=form 的扩展 + 卡片配置。
    // 少任何一项（extensionAbilities / metadata / form_config.json）桌面上都不会出现这一项，
    // 而且不会有任何报错 —— 只是长按应用时看不到「服务卡片」。
    "extensionAbilities": [
      {
        "name": "EntryFormAbility",
        "srcEntry": "./ets/entryformability/EntryFormAbility.ets",
        "label": "$string:EntryFormAbility_label",
        "description": "$string:EntryFormAbility_desc",
        "type": "form",
        "exported": true,
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:form_config"
          }
        ]
      }
    ]
  }
}
