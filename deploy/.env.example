# 复制成 .env 后按你的环境填写。此文件不要提交。
# 所有值都是占位符，不含任何真实地址或凭据。

# --- 连接 Amane ---
AMANE_BASE=http://amane:8000
AMANE_DATA=/path/to/amane/data
AMANE_TOKEN=replace-with-your-amane-token
# IMAGE_TOKEN 不填则读 {AMANE_DATA}/image_token
IMAGE_TOKEN=

# --- 本服务 ---
DATA_DIR=./data
PORT=8770
# 追加允许代理的图片主机，逗号分隔
IMG_HOST_ALLOW_EXTRA=

# --- 媒体卷（字幕功能需要，只读） ---
MEDIA_ROOT=/path/to/media
# amane 容器内路径 = 本机/容器内可见路径，逗号分隔，服务按最长前缀匹配
MEDIA_PATH_MAP=/media2=/mnt/media2,/media=/mnt/media

# --- 可选 ---
# PUBLIC_AMANE_URL=
# VERBOSE=1
