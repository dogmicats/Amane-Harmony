# 复制成 .env 后按你的环境填写。此文件不要提交。
# 所有值都是占位符，不含任何真实地址或凭据。

# --- 连接 Amane ---
AMANE_BASE=http://amane:8000
AMANE_DATA=/path/to/amane/data
AMANE_TOKEN=replace-with-your-amane-token
# IMAGE_TOKEN 不填则读 {AMANE_DATA}/image_token
IMAGE_TOKEN=

# --- 本服务 ---
DATA_DIR=./data
PORT=8770
# 播放块缓存上限（MB）。网盘 / 冷区源建议保持默认 320；内存紧张可调低
AMANE_PLAY_CACHE_MB=320
# 追加允许代理的图片主机，逗号分隔
IMG_HOST_ALLOW_EXTRA=

# --- 媒体卷（字幕「同目录」来源需要，只读） ---
# MEDIA_ROOT 只是 compose 里宿主路径的占位（挂到容器 /mnt/media），本身不参与路径解析
MEDIA_ROOT=/path/to/media
# 真正决定能否读到同目录字幕：左边是 amane 容器内路径前缀，右边是本服务可见的路径。
# 右边必须是 compose 里挂进来的那个容器路径（默认 /mnt/media）；多个盘要各自加卷再逗号追加
MEDIA_PATH_MAP=/media2=/mnt/media

# --- 可选 ---
# PUBLIC_AMANE_URL=
# VERBOSE=1
