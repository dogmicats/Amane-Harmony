{
  "schema": 1,
  "_readme": "服务端扩展清单（公开版）。core 只留 ExtensionHost，具体能力由这里的条目动态加载；删掉某条即整体退化，核心代码无需改动。",
  "extensions": [
    {
      "id": "actors",
      "title": "演员页",
      "scope": "public",
      "entry": "ext/actors/server_ext.py",
      "enabled": true
    },
    {
      "id": "facets",
      "title": "分类浏览（标签 / 系列 / 制片商）",
      "scope": "public",
      "entry": "ext/facets/server_ext.py",
      "enabled": true
    },
    {
      "id": "subtitles",
      "title": "外挂字幕",
      "scope": "public",
      "entry": "ext/subtitles/server_ext.py",
      "enabled": true
    },
    {
      "id": "stills",
      "title": "抽卡模式（随机剧照墙）",
      "scope": "public",
      "entry": "ext/stills/server_ext.py",
      "enabled": true
    },
    {
      "id": "highlights",
      "title": "影片亮点（随机位置缩略图，点图从该处播放）",
      "scope": "public",
      "entry": "ext/highlights/server_ext.py",
      "enabled": true
    },
    {
      "id": "trailers",
      "title": "预告片（详情页入口 + 预告片盲盒）",
      "scope": "public",
      "entry": "ext/trailers/server_ext.py",
      "enabled": true
    },
    {
      "id": "collections",
      "title": "??????????????????",
      "scope": "public",
      "entry": "ext/collections/server_ext.py",
      "enabled": true
    },
    {
      "id": "ratings",
      "title": "?????1?5 ?????????",
      "scope": "public",
      "entry": "ext/ratings/server_ext.py",
      "enabled": true
    },
    {
      "id": "watch_later",
      "title": "稍后再看",
      "scope": "public",
      "entry": "ext/watch_later/server_ext.py",
      "enabled": true
    }
  ]
}
