# 凭据与本地配置（绝不入库）
.env
*.env
config/*.local.json
**/config.local.json
*.local.json

# 运行时数据
data/
*.db
*.db-wal
*.db-shm
# 运行时缓存目录（DATA_DIR 下），别把 server/ext/subtitles 一起忽略掉
/data/subtitles/
/data/imgcache/
*.log
*.jsonl

# 构建产物与缓存
dist/
build/
oh_modules/
.hvigor/
.sign/
*.hap
__pycache__/
*.pyc
.DS_Store

# 本仓库的 BuildConfig.ets 是 public 通道生成物（全空），需要入库，故不忽略。

# 服务端中文检索词表：随源码包一起发（升级后停用拼音会导致静默降级）
!server/data/
!server/data/*.tsv
